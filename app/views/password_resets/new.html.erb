<% content_for :title, "Forgot password" %>
<%= render layout: "password_resets/shell", locals: { title: "Forgot password", subtitle: "We will email you a link to set a new password" } do %>
  <%= form_with url: password_reset_path, method: :post, class: "mt-6 space-y-4", data: { turbo: false } do %>
    <div>
      <%= label_tag :emp_code, "Employee Code", class: "lbl" %>
      <div class="relative">
        <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-emerald-700/70"><%= icon(:user, "h-5 w-5") %></span>
        <%= text_field_tag :emp_code, nil, autofocus: true, required: true, autocomplete: "username", placeholder: "e.g. 1025", class: "inp pl-10" %>
      </div>
      <p class="mt-1.5 text-xs text-slate-500">The link goes to the email registered with PD HR. It works once and expires in 6 hours.</p>
    </div>
    <%= button_tag type: "submit", class: "btn-primary login-btn" do %>Send reset link <%= icon(:send) %><% end %>
  <% end %>
<% end %>
