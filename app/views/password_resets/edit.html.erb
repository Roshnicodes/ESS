<% content_for :title, "Set new password" %>
<%= render layout: "password_resets/shell", locals: { title: "Set new password", subtitle: "Choose a new password for ESS" } do %>
  <% if @errors.present? %>
    <div class="mt-4 rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700"><% @errors.each do |m| %><div><%= m %></div><% end %></div>
  <% end %>
  <%= form_with url: password_reset_path, method: :patch, class: "mt-6 space-y-4", data: { turbo: false } do %>
    <%= hidden_field_tag :token, @token %>
    <div data-controller="reveal">
      <%= label_tag :password, "New password", class: "lbl" %>
      <div class="relative">
        <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-emerald-700/70"><%= icon(:lock, "h-5 w-5") %></span>
        <%= password_field_tag :password, nil, required: true, autofocus: true, autocomplete: "new-password", class: "inp pl-10 pr-10", data: { reveal_target: "input" } %>
        <button type="button" class="absolute inset-y-0 right-2 flex items-center px-1 text-slate-400 hover:text-emerald-700" data-action="reveal#toggle" title="Show / hide password"><%= icon(:eye, "h-5 w-5") %></button>
      </div>
    </div>
    <div>
      <%= label_tag :password_confirmation, "Confirm new password", class: "lbl" %>
      <%= password_field_tag :password_confirmation, nil, required: true, autocomplete: "new-password", class: "inp" %>
    </div>
    <%= button_tag type: "submit", class: "btn-primary login-btn" do %>Save new password <%= icon(:check) %><% end %>
  <% end %>
<% end %>
