<%# locals: (id:, url:, title:, note: nil) %>
<dialog id="<%= id %>" data-action="click->dialog#backdrop"
        class="m-auto w-[min(28rem,calc(100vw-1.5rem))] rounded-2xl border border-white/70 bg-white/95 p-0 shadow-2xl backdrop:bg-slate-900/40 backdrop:backdrop-blur-sm">
  <%= form_with url: url, method: :delete, class: "space-y-3 p-5" do %>
    <div class="flex items-start gap-3">
      <span class="icon-chip bg-rose-50 text-rose-600"><%= icon(:trash) %></span>
      <div><div class="font-semibold text-slate-900"><%= title %></div><% if note %><div class="text-sm text-slate-500"><%= note %></div><% end %></div>
    </div>
    <div><label class="lbl" for="<%= id %>-remark">Reason for delete <span class="text-rose-500">*</span></label>
      <%= text_area_tag :delete_remark, nil, id: "#{id}-remark", rows: 2, required: true, class: "inp" %></div>
    <p class="text-[11px] text-slate-500">It disappears from all lists; who deleted it, when and why stays in the audit trail.</p>
    <div class="flex justify-end gap-2">
      <button type="button" class="btn-ghost" data-action="dialog#close">Cancel</button>
      <%= button_tag class: "btn-danger" do %><%= icon(:trash) %> Delete<% end %>
    </div>
  <% end %>
</dialog>
