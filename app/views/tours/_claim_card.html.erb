<%# locals: (tour:, c:, claim_logs:) %>
<%# The TA/DA claim of an outstation tour – its own card, status, history and stamp, apart from the tour plan's %>
<div class="card mt-5 overflow-hidden border-l-4 border-l-violet-400 fade-up">
  <div class="flex flex-wrap items-center gap-x-5 gap-y-2 border-b border-white/70 px-4 py-3 sm:px-5">
    <span class="flex items-center gap-2 text-base font-bold text-slate-900"><span class="icon-chip bg-violet-50 text-violet-600"><%= icon(:receipt) %></span>TA/DA Claim</span>
    <% if c %>
      <%= claim_status_badge(c, label: ("Claim approved" if c.approved?)) %>
      <span class="text-sm text-slate-700"><%= c.stage_label %></span>
      <span class="text-sm"><span class="text-xs font-semibold uppercase tracking-wide text-slate-400">Amount:</span> <b class="text-slate-900"><%= inr(c.grand_total) %></b></span>
      <% if c.bank_account && (tour.user_id == current_user.id || can?(:read, c.bank_account)) %>
        <span class="text-sm"><span class="text-xs font-semibold uppercase tracking-wide text-slate-400">Bank:</span> <%= c.bank_account.label %></span>
      <% end %>
    <% else %>
      <%= status_badge("draft", label: "Not made yet") %>
      <span class="text-sm text-slate-500"><%= tour.claimable? ? "The tour is over – the claim can be made now." : "The claim can be made after the tour ends (#{d(tour.to_date)})." %></span>
    <% end %>
    <span class="ml-auto flex flex-wrap gap-1.5 print:hidden"><%= render "tours/claim_buttons", tour: tour, c: c %></span>
  </div>
  <% if c %>
    <div class="flex flex-wrap items-center gap-4 bg-white/30 px-4 py-3 sm:px-5">
      <div class="min-w-0 flex-1 print:hidden"><%= render "shared/history_lines", logs: claim_logs, title: "Claim history" %></div>
      <%= approval_seal(c, css: "ml-auto mr-6 shrink-0", top: "Claim") %>
    </div>
  <% end %>
</div>
