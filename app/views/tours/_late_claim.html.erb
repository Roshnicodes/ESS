<%# locals: (month:, request:, tour:) %>
<%# Local mileage after the cutoff day: ask PD HR, then fill the claim once allowed (COO is its last approver) %>
<% label = month.strftime("%b-%Y") %>
<% if request&.approved? %>
  <div class="mb-4 flex flex-wrap items-center gap-3 rounded-2xl border border-emerald-200 bg-emerald-50/80 px-4 py-3 text-sm text-emerald-900 fade-up print:hidden">
    <%= icon(:check_circle, "h-5 w-5 shrink-0 text-emerald-600") %>
    <div class="min-w-0 flex-1">PD HR <b><%= request.decided_by %></b> allowed your late local mileage claim for <b><%= label %></b>
      on <%= dt(request.decided_at) %><% if request.decision_remark.present? %> – “<%= request.decision_remark %>”<% end %>.
      <div class="mt-0.5 text-xs">After L1 (and L2), the claim goes to the COO for the last approval, then to Finance.</div></div>
    <%= link_to (tour ? (tour.tour_claim ? edit_tour_claim_path(tour) : new_tour_claim_path(tour)) : new_local_mileage_path(month: month.strftime("%Y-%m"))), class: "btn-success btn-xs" do %><%= icon(:pencil) %> Fill <%= label %> claim<% end %>
  </div>
<% elsif request&.pending? %>
  <div class="mb-4 flex gap-3 rounded-2xl border border-amber-200 bg-amber-50/80 px-4 py-3 text-sm text-amber-900 fade-up print:hidden">
    <%= icon(:clock, "h-5 w-5 shrink-0 text-amber-500") %>
    <div>Late claim for <b><%= label %></b> is waiting for <b>PD HR</b> approval since <%= dt(request.created_at) %>.
      <div class="mt-0.5 text-xs italic">“<%= request.reason %>”</div></div>
  </div>
<% else %>
  <details class="card mb-4 fade-up print:hidden" <%= "open" if request&.rejected? %>>
    <summary class="flex cursor-pointer items-center gap-2 px-4 py-3 text-sm font-semibold text-slate-700">
      <%= icon(:warning, "h-4 w-4 text-amber-500") %> Missed the cutoff for <%= label %>? Ask PD HR for a late claim
    </summary>
    <div class="space-y-3 border-t border-white/70 px-4 py-3">
      <% if request&.rejected? %>
        <div class="rounded-xl bg-rose-50 px-3 py-2 text-sm text-rose-800">Your last request was not allowed by PD HR <b><%= request.decided_by %></b>
          on <%= dt(request.decided_at) %> – “<%= request.decision_remark %>”. You may ask again with more detail.</div>
      <% end %>
      <%= form_with url: late_claim_requests_path, method: :post, class: "space-y-3", data: { turbo: false } do %>
        <div><label class="lbl" for="late_reason">Why is the <%= label %> claim late? <span class="text-rose-500">*</span></label>
          <%= text_area_tag :reason, nil, id: "late_reason", rows: 2, required: true, maxlength: 2000, class: "inp", placeholder: "Reason (required)" %></div>
        <p class="text-xs text-slate-500">The request goes to PD HR. Once approved you can fill and send the <%= label %> claim – it goes to L1 (and L2), then to the COO for the last approval, then to Finance.</p>
        <%= button_tag class: "btn-primary", data: { turbo_confirm: "Send the late claim request for #{label} to PD HR?" } do %><%= icon(:send) %> Send to PD HR<% end %>
      <% end %>
    </div>
  </details>
<% end %>
