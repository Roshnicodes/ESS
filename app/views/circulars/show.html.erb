<% c = @circular %>
<% content_for :title, "#{c.type_label}: #{c.topic}" %>
<div class="mb-4 flex flex-wrap items-center gap-2 print:hidden">
  <%= link_to circulars_path, class: "btn-light btn-xs" do %><%= icon(:arrow_right, "h-4 w-4 rotate-180") %> All IOM / Circular<% end %>
  <span class="ml-auto flex gap-2">
    <%= print_button("Print", css: "btn-light btn-xs") %>
    <%= link_to edit_masters_circular_path(c), class: "btn-light btn-xs" do %><%= icon(:pencil) %> Edit<% end if current_user.admin? %>
  </span>
</div>

<div class="card overflow-hidden fade-up">
  <div class="flex flex-wrap items-center gap-3 border-b border-white/70 px-4 py-3 sm:px-5">
    <span class="rounded-full px-2.5 py-0.5 text-xs font-bold <%= c.type_iom? ? 'bg-violet-50 text-violet-700' : 'bg-sky-50 text-sky-700' %>"><%= c.type_label %></span>
    <span class="text-lg font-bold text-slate-900"><%= c.topic %></span>
    <% unless c.active? %><span class="rounded-full bg-rose-50 px-2 py-0.5 text-xs font-semibold text-rose-700">Inactive</span><% end %>
    <span class="ml-auto text-xs text-slate-500">Published <%= dt(c.created_at) %> by <%= c.created_by.name %></span>
  </div>

  <% if c.description.present? %>
    <div class="whitespace-pre-line px-4 py-4 text-sm leading-relaxed text-slate-700 sm:px-5"><%= c.description %></div>
  <% end %>

  <% if c.attachments.attached? %>
    <div class="border-t border-white/70 px-4 py-4 sm:px-5">
      <div class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-400">Attachments</div>
      <ul class="grid gap-2 sm:grid-cols-2">
        <% c.attachments.each do |a| %>
          <li class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white/60 px-3 py-2.5">
            <%= icon(:document, "h-5 w-5 shrink-0 text-slate-400") %>
            <span class="min-w-0 flex-1 leading-tight">
              <%= link_to a.filename.to_s, attachment_circular_path(c, attachment_id: a.id), target: "_blank", rel: "noopener", class: "link block truncate font-medium" %>
              <span class="muted"><%= number_to_human_size(a.byte_size) %></span>
            </span>
            <%= link_to attachment_circular_path(c, attachment_id: a.id, download: 1), class: "btn-light btn-xs btn-icon print:hidden", title: "Download", data: { turbo: false }, aria: { label: "Download #{a.filename}" } do %><%= icon(:download) %><% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="border-t border-white/70 bg-white/30 px-4 py-3 text-xs text-slate-500 sm:px-5">
    Sent to <%= c.audience_label.downcase %><%= " on #{dt(c.notified_at)}" if c.notified? %>.
  </div>
</div>
