<% content_for :title, "On Tour Today" %>
<% approved = @tours.count(&:approved?) %>
<%= page_header("Colleagues on tour today", "#{d(@day)} · #{@tours.size} on tour · #{approved} plan approved · #{@tours.size - approved} waiting for approval", icon_name: :building) do %>
  <%= print_button %>
<% end %>

<div class="card overflow-hidden fade-up" data-controller="dialog">
  <div class="overflow-x-auto"><table class="tbl tbl-hover tbl-stack">
    <thead><tr><th>Employee</th><th>Tour</th><th>Today at</th><th>Tour Plan status</th><th class="text-right no-print">Details</th></tr></thead>
    <tbody>
    <% @tours.each do |t| %>
      <% u = t.user; today_places = t.tour_visits.select { |v| v.visit_date == @day }.map(&:place).compact_blank.uniq %>
      <tr class="cursor-pointer" data-action="click->dialog#open" data-dialog-id-param="tour-<%= t.id %>">
        <td data-label="Employee"><div class="flex items-center gap-2.5"><%= avatar(u, size: "h-9 w-9 text-xs") %>
          <div class="leading-tight"><b class="text-slate-900"><%= u.name %></b><div class="muted"><%= [u.designation, u.emp_code, u.location].compact_blank.join(" · ") %></div></div></div></td>
        <td data-label="Tour"><span class="font-medium"><%= t.duration_label %></span><div class="muted"><%= t.days %> <%= "day".pluralize(t.days) %></div></td>
        <td data-label="Today at"><%= today_places.any? ? today_places.join(", ") : tag.span("—", class: "text-slate-400") %></td>
        <td data-label="Status"><div><%= tour_status_badge(t, label: { "submitted" => "Pending L1", "l1_approved" => "Forwarded to L2", "l2_approved" => "Forwarded to #{t.l3_label}" }[t.status]) %>
          <div class="muted mt-1"><%= t.stage_label %></div></div></td>
        <td class="no-print"><div class="flex justify-end">
          <button type="button" class="btn-light btn-xs" data-action="dialog#open:stop" data-dialog-id-param="tour-<%= t.id %>"><%= icon(:eye) %> Details</button></div></td>
      </tr>
    <% end %>
    <%= empty_row(5, "No one is on tour today", icon_name: :map) if @tours.empty? %>
    </tbody>
  </table></div>

  <% @tours.each do |t| %>
    <% u = t.user %>
    <dialog id="tour-<%= t.id %>" data-action="click->dialog#backdrop"
            class="m-auto w-[min(46rem,calc(100vw-1.5rem))] rounded-2xl border border-white/70 bg-white p-0 shadow-2xl backdrop:bg-slate-900/40">
      <div class="flex items-start justify-between gap-3 border-b border-slate-100 px-5 py-4">
        <div class="flex items-center gap-3"><%= avatar(u, size: "h-11 w-11 text-sm") %>
          <div class="leading-tight"><div class="text-base font-bold text-slate-900"><%= u.name %></div>
            <div class="muted"><%= [u.designation, u.emp_code, u.location].compact_blank.join(" · ") %></div></div></div>
        <button type="button" class="btn-ghost btn-xs" data-action="dialog#close" aria-label="Close"><%= icon(:x_circle, "h-5 w-5") %></button>
      </div>
      <div class="max-h-[75vh] space-y-4 overflow-y-auto px-5 py-4 text-sm">
        <div class="grid gap-3 sm:grid-cols-4">
          <div><div class="lbl">From</div><b><%= d(t.from_date) %></b></div>
          <div><div class="lbl">To</div><b><%= d(t.to_date) %></b></div>
          <div><div class="lbl">Total</div><b><%= t.days %> <%= "day".pluralize(t.days) %></b> <span class="muted">· day <%= (@day - t.from_date).to_i + 1 %> today</span></div>
          <div><div class="lbl">Tour Plan status</div><%= tour_status_badge(t) %><div class="muted mt-1"><%= t.stage_label %></div></div>
        </div>
        <div><div class="lbl">Approval</div><div class="flex flex-wrap items-center"><%= approver_chain(t.approver, t.l2_approver, t.approval_steps) %></div></div>
        <% if t.general_description.present? %><div><div class="lbl">Purpose</div><p class="text-slate-700"><%= t.general_description %></p></div><% end %>
        <div>
          <div class="lbl">Visits</div>
          <table class="tbl tbl-stack rounded-xl ring-1 ring-slate-200">
            <thead><tr><th>Date</th><th>Place</th><th>Mode of travel</th><th>Planned activities</th></tr></thead>
            <tbody>
            <% t.tour_visits.sort_by { |v| [v.visit_date || t.from_date, v.id] }.each do |v| %>
              <tr class="<%= 'bg-amber-50/70' if v.visit_date == @day %>">
                <td data-label="Date" class="whitespace-nowrap"><%= d(v.visit_date) %><% if v.visit_date == @day %> <span class="ml-1 rounded bg-amber-100 px-1.5 py-0.5 text-[10px] font-bold uppercase text-amber-700">Today</span><% end %></td>
                <td data-label="Place" class="font-medium"><%= v.place %></td>
                <td data-label="Mode"><%= v.travel_mode || "—" %><% if v.tatkal? %> <span class="ml-1 rounded bg-orange-100 px-1.5 py-0.5 text-[10px] font-bold uppercase text-orange-700">Tatkal</span><% end %></td>
                <td data-label="Activities" class="text-slate-600"><%= v.planned_activity %></td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </dialog>
  <% end %>
</div>
