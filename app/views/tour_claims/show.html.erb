<% content_for :title, "Claim Form" %>
<%= page_header(@claim.type_local? ? "Local Mileage Claim Form" : "Tour Claim Form", @tour.duration_label, icon_name: :receipt) do %>
  <%= history_link(@tour) %>
  <%= print_button %>
<% end %>
<%= render "tour_claims/summary", claim: @claim %>
<div class="seal-foot"><%= approval_seal(@claim) %></div>
<%= render "shared/print_signatures", rows: [ [ "Employee", @claim.user.name, @claim.submitted_at ],
      [ "L1", (@claim.l1_approved_by || @claim.l1_approver)&.name, @claim.l1_approved_at ],
      ([ "L2", (@claim.l2_approved_by || @claim.l2_approver)&.name, @claim.l2_approved_at ] if @claim.l2_approver_id),
      [ "Finance", (@claim.approved_by || @claim.finance_approver)&.name, @claim.approved_at ] ].compact %>
