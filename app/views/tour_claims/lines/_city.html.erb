<tr data-nested-row data-new-record="<%= f.object.new_record? %>">
  <td data-label="Date"><%= f.date_field :travel_date, class: "inp", min: @tour.from_date, max: @tour.to_date %></td>
  <td data-label="Departure City"><%= f.text_field :departure_city, class: "inp" %></td>
  <td data-label="Arrived City"><%= f.text_field :arrival_city, class: "inp" %></td>
  <td data-label="Mode of Travel"><%= f.collection_select :travel_mode_id, city_travel_modes, :id, :name, {}, class: "inp" %></td>
  <td data-label="Bill/Ticket No."><%= f.text_field :bill_ticket_no, class: "inp" %></td>
  <td data-label="Remark"><%= f.text_field :remark, class: "inp" %></td>
  <td data-label="Amt."><%= f.number_field :amount, step: "0.01", min: 0, value: (f.object.amount.to_d.zero? ? nil : f.object.amount), placeholder: "0.00", class: "inp text-right", data: { calc: "amount" } %></td>
  <%= render "tour_claims/lines/tail", f: f %>
  <td class="w-16 whitespace-nowrap text-right"><%= render "tour_claims/lines/row_actions" %></td>
</tr>
