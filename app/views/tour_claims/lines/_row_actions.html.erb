<span class="inline-flex gap-0.5">
  <button type="button" class="rounded-lg p-1.5 text-brand-600 hover:bg-brand-50" data-action="nested-rows#addAfter" title="Add row below"><%= icon(:plus, "h-4 w-4") %><span class="sr-only">Add row</span></button>
  <button type="button" class="rounded-lg p-1.5 text-rose-500 hover:bg-rose-50" data-action="nested-rows#remove" title="Remove row"><%= icon(:trash, "h-4 w-4") %><span class="sr-only">Remove</span></button>
</span>
