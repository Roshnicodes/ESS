<% content_for :title, "Bank Details" %>
<%= page_header("Bank Details", "Add your bank accounts with passbook copy. Choose one on every claim – Finance pays into it.", icon_name: :banknotes) do %>
  <%= print_button %>
  <%= render "shared/activity_button", id: "bank-history", title: "Bank details history", sections: [["Changes", @logs.reverse]] %>
  <%= link_to new_account_bank_account_path, class: "btn-primary" do %><%= icon(:plus) %> Add Bank Account<% end %>
<% end %>

<% if @accounts.empty? %>
  <div class="card fade-up"><div class="empty-state py-14"><%= icon(:banknotes) %><span>No bank account added yet.</span>
    <%= link_to new_account_bank_account_path, class: "btn-primary mt-3" do %><%= icon(:plus) %> Add Bank Account<% end %></div></div>
<% else %>
  <div class="grid gap-5 md:grid-cols-2 2xl:grid-cols-3">
    <% @accounts.each do |a| %>
      <div class="bank-card card overflow-hidden fade-up <%= 'is-off' unless a.active? %>">
        <div class="bank-card-top">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <div class="truncate text-lg font-bold"><%= a.bank_name %></div>
              <div class="truncate text-xs text-white/80"><%= a.branch_name.presence || "—" %> · <%= a.account_type.humanize %></div>
            </div>
            <div class="flex shrink-0 flex-col items-end gap-1">
              <% if a.primary? %><span class="rounded-full bg-white/95 px-2 py-0.5 text-[11px] font-bold text-brand-700">★ Primary</span><% end %>
              <% unless a.active? %><span class="rounded-full bg-slate-900/40 px-2 py-0.5 text-[11px] font-semibold">Deactivated</span><% end %>
            </div>
          </div>
          <div class="mt-5 font-mono text-xl tracking-[0.18em]"><%= a.account_number.scan(/.{1,4}/).join(" ") %></div>
          <div class="mt-3 flex items-end justify-between gap-3 text-xs">
            <div class="min-w-0"><div class="text-white/70">Account holder</div><div class="truncate text-sm font-semibold"><%= a.account_holder_name %></div></div>
            <div class="text-right"><div class="text-white/70">IFSC</div><div class="font-mono text-sm font-semibold"><%= a.ifsc_code %></div></div>
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-2 px-4 py-3">
          <%= button_to toggle_account_bank_account_path(a), method: :patch, class: "group inline-flex items-center gap-2", form_class: "inline",
                title: a.active? ? "Deactivate" : "Activate",
                data: { turbo_confirm: a.active? ? "Deactivate #{a.label}? It will not be offered on new claims." : nil } do %>
            <span class="relative inline-flex h-6 w-11 items-center rounded-full transition <%= a.active? ? 'bg-emerald-500' : 'bg-slate-300' %>"><span class="absolute h-5 w-5 rounded-full bg-white shadow transition <%= a.active? ? 'left-[22px]' : 'left-0.5' %>"></span></span>
            <span class="text-xs font-semibold <%= a.active? ? 'text-emerald-700' : 'text-slate-500' %>"><%= a.active? ? "Active" : "Inactive" %></span>
          <% end %>
          <span class="ml-auto flex flex-wrap gap-1.5">
            <% if a.passbook.attached? %>
              <%= link_to passbook_account_bank_account_path(a), target: "_blank", class: "btn-light btn-xs" do %><%= icon(:eye) %> Passbook<% end %>
            <% end %>
            <% if a.active? && !a.primary? %>
              <%= button_to make_primary_account_bank_account_path(a), method: :patch, class: "btn-light btn-xs", form_class: "inline" do %>★ Make primary<% end %>
            <% end %>
            <%= link_to edit_account_bank_account_path(a), class: "btn-light btn-xs" do %><%= icon(:pencil) %> Edit<% end %>
          </span>
        </div>
      </div>
    <% end %>
  </div>
  <p class="mt-4 text-xs text-slate-500">The <b>primary</b> account is selected by default on a new claim – you can pick another active account in the claim form. An account used on a sent claim cannot be changed; deactivate it and add a new one.</p>
<% end %>
