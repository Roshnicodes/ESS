<% if page.current? %><span class="inline-flex h-8 min-w-8 items-center justify-center rounded-lg bg-brand-600 px-2 font-semibold text-white"><%= page %></span>
<% else %><%= link_to page, url, rel: page.rel, class: "inline-flex h-8 min-w-8 items-center justify-center rounded-lg px-2 text-slate-600 hover:bg-slate-100" %><% end %>
