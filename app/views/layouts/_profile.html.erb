<% u = current_user %>
<details class="profile-menu relative">
  <summary class="flex cursor-pointer list-none items-center gap-2 rounded-xl p-1 pr-2 hover:bg-white/70" title="My profile">
    <div class="hidden text-right leading-tight md:block">
      <div class="text-sm font-semibold"><%= u.name %></div>
      <div class="text-[11px] text-slate-500"><%= u.emp_code %> · <%= role_label(u) %></div>
    </div>
    <%= avatar(u, size: "h-9 w-9 text-sm ring-2 ring-white shadow") %>
    <%= icon(:chevron_down, "hidden h-4 w-4 text-slate-400 md:block") %>
  </summary>
  <div class="absolute right-0 z-50 mt-2 w-[min(22rem,calc(100vw-1.5rem))] overflow-hidden rounded-2xl border border-white/70 bg-white/95 shadow-2xl backdrop-blur-xl">
    <div class="flex items-center gap-3 bg-gradient-to-br from-brand-600 to-brand-800 px-4 py-4 text-white">
      <%= avatar(u, size: "h-12 w-12 text-base ring-2 ring-white/70") %>
      <div class="min-w-0 leading-tight">
        <div class="truncate font-bold"><%= u.name %></div>
        <div class="truncate text-xs text-white/80"><%= u.designation.presence || role_label(u) %></div>
        <div class="mt-1 inline-flex rounded-full bg-white/20 px-2 py-0.5 text-[11px] font-semibold">Emp. Code <%= u.emp_code %></div>
      </div>
    </div>
    <dl class="grid grid-cols-[7rem_1fr] gap-x-3 gap-y-1.5 px-4 py-3 text-sm">
      <% [["Role", role_label(u)], ["Department", u.department], ["Location", u.location], ["Branch", [u.branch, u.sub_branch].compact_blank.join(" / ")],
          ["Mobile", u.mobile], ["Email", u.email], ["Joining", (d(u.date_of_joining) if u.date_of_joining)],
          ["L1 Manager", u.reporting_manager&.name], ["L2 Manager", u.l2_manager&.name], ["Finance", u.finance_approver&.name]].each do |label, value| %>
        <% next if value.blank? %>
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-400"><%= label %></dt>
        <dd class="min-w-0 break-words font-medium text-slate-700"><%= value %></dd>
      <% end %>
    </dl>
    <div class="flex items-center gap-2 border-t border-slate-100 px-4 py-3">
      <%= link_to edit_account_password_path, class: "btn-light btn-xs flex-1 justify-center" do %><%= icon(:lock, "h-4 w-4") %> Change Password<% end %>
      <%= button_to destroy_user_session_path, method: :delete, class: "btn-soft-danger btn-xs w-full justify-center", form_class: "flex-1", form: { data: { turbo: false } } do %><%= icon(:logout, "h-4 w-4") %> Logout<% end %>
    </div>
  </div>
</details>
