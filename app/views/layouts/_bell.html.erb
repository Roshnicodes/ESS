<% unread = current_user.notifications.unread.count %>
<% latest = current_user.notifications.limit(8) %>
<details class="relative">
  <summary class="relative rounded-lg p-2 text-slate-600 hover:bg-white/70" title="Notifications">
    <%= icon(:inbox, "h-5 w-5") %>
    <% if unread.positive? %><span class="absolute -right-0.5 -top-0.5 min-w-5 rounded-full bg-rose-500 px-1 text-center text-[11px] font-bold leading-5 text-white"><%= unread > 99 ? "99+" : unread %></span><% end %>
  </summary>
  <div class="absolute right-0 z-50 mt-2 w-[min(24rem,calc(100vw-1.5rem))] overflow-hidden rounded-2xl border border-white/70 bg-white/95 shadow-2xl backdrop-blur-xl">
    <div class="flex items-center justify-between border-b border-slate-100 px-4 py-2.5">
      <span class="text-sm font-semibold">Notifications <%= "(#{unread} new)" if unread.positive? %></span>
      <% if unread.positive? %><%= button_to "Mark all read", mark_all_read_notifications_path, method: :patch, class: "text-xs font-semibold text-brand-600 hover:underline" %><% end %>
    </div>
    <ul class="max-h-96 divide-y divide-slate-100 overflow-y-auto">
      <% latest.each do |n| %>
        <li><%= link_to notification_path(n), class: "block px-4 py-2.5 hover:bg-slate-50 #{'bg-brand-50/60' unless n.read?}" do %>
          <span class="block text-sm <%= n.read? ? 'text-slate-700' : 'font-semibold text-slate-900' %>"><%= n.title %></span>
          <span class="block truncate text-xs text-slate-500"><%= n.body %></span>
          <span class="block text-[11px] text-slate-400"><%= dt(n.created_at) %></span>
        <% end %></li>
      <% end %>
      <% if latest.empty? %><li class="px-4 py-6 text-center text-sm text-slate-400">No notifications yet</li><% end %>
    </ul>
    <%= link_to "See all", notifications_path, class: "block border-t border-slate-100 px-4 py-2 text-center text-sm font-semibold text-brand-600 hover:bg-slate-50" %>
  </div>
</details>
