<% content_for :title, "Notifications" %>
<%= page_header("Notifications", "Every approval, forward, return and rejection that concerns you.", icon_name: :inbox) do %>
  <%= print_button %>
  <%= button_to mark_all_read_notifications_path, method: :patch, class: "btn-light" do %><%= icon(:check) %> Mark all read<% end %>
<% end %>
<div class="card overflow-hidden fade-up">
  <ul class="divide-y divide-white/70">
    <% @notifications.each do |n| %>
      <li>
        <%= link_to notification_path(n), class: "flex items-start gap-3 px-4 py-3 hover:bg-white/50 sm:px-5 #{'bg-brand-50/50' unless n.read?}" do %>
          <span class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full <%= n.read? ? 'bg-slate-300' : 'bg-brand-500' %>"></span>
          <span class="min-w-0 flex-1">
            <span class="block text-sm <%= n.read? ? 'text-slate-700' : 'font-semibold text-slate-900' %>"><%= n.title %></span>
            <span class="block text-sm text-slate-600"><%= n.body %></span>
          </span>
          <span class="shrink-0 whitespace-nowrap text-xs text-slate-400"><%= dt(n.created_at) %></span>
        <% end %>
      </li>
    <% end %>
    <% if @notifications.empty? %><li class="empty-state"><%= icon(:inbox) %>No notifications yet</li><% end %>
  </ul>
  <% if @notifications.total_pages > 1 %><div class="border-t border-white/70 px-4 py-3"><%= paginate @notifications %></div><% end %>
</div>
